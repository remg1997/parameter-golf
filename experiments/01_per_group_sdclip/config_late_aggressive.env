export DATA_DIR=/workspace/data/
# Experiment 01 ALT: aggressive late, baseline-equivalent elsewhere.
# Goal: shrink artifact size (so we have headroom under 16MB) without losing
# BPB. Pushes late=18.0 (much wider clip = lower entropy = smaller after Brotli)
# while keeping all other groups at baseline k=12.85. Net should be smaller
# artifact at ~equal BPB.

export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

# --- LATE-AGGRESSIVE schedule ---
export PER_GROUP_QUANT_ENABLED=1
export GROUP_CLIP_SIGMAS_EARLY=12.85
export GROUP_CLIP_SIGMAS_LOOP=12.85
export GROUP_CLIP_SIGMAS_MID=12.85
export GROUP_CLIP_SIGMAS_LATE=18.0
export GROUP_CLIP_SIGMAS_EMBED=20.0
export GROUP_BITS_EARLY=6
export GROUP_BITS_LOOP=6
export GROUP_BITS_MID=6
export GROUP_BITS_LATE=6
export GROUP_BITS_EMBED=8

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=01_per_group_sdclip_late_aggressive
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
export COMPRESSOR=brotli
