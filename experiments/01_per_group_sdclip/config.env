export DATA_DIR=/workspace/data/
# Experiment 01 — per-group SDClip allocator. Source this before torchrun:
#   source experiments/01_per_group_sdclip/config.env
#   torchrun --standalone --nproc_per_node=3 experiments/01_per_group_sdclip/tw_eval.py

# --- canonical SOTA stack (bigbag, 1.0810) ---
export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

# --- experiment 01 toggles ---
export PER_GROUP_QUANT_ENABLED=1
export GROUP_CLIP_SIGMAS_EARLY=10.5
export GROUP_CLIP_SIGMAS_LOOP=12.0
export GROUP_CLIP_SIGMAS_MID=12.85
export GROUP_CLIP_SIGMAS_LATE=14.5
export GROUP_CLIP_SIGMAS_EMBED=20.0
export GROUP_BITS_EARLY=6
export GROUP_BITS_LOOP=6
export GROUP_BITS_MID=6
export GROUP_BITS_LATE=6
export GROUP_BITS_EMBED=8

# --- wandb ---
export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=01_per_group_sdclip
# RUN_ID=01_pgsdclip_seed42  (set per-run in your launch command)
# SEED=42                    (set per-run)

# extended wallclock for ws=3 (~2.67x of 8xH100 to hit ~5088 steps)
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500

# explicit defaults to avoid env pollution from other experiments
export COMPRESSOR=brotli
