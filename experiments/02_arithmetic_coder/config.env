# Experiment 02 — alternative compressor (zstd-22 + self-trained dict). Source then run:
#   source experiments/02_arithmetic_coder/config.env
#   torchrun --standalone --nproc_per_node=3 experiments/02_arithmetic_coder/train_gpt.py

# --- canonical SOTA stack (bigbag, 1.0810) ---
export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

# --- experiment 02 toggles ---
# 'brotli' (SOTA) | 'lzma' | 'zstd' | 'zstd_dict'
export COMPRESSOR=zstd_dict
export BYTE_SHUFFLE=1
export ZSTD_LEVEL=22
export ZSTD_DICT_SIZE=8192
export COMPRESS_COMPARE=1
export COMPRESS_ROUNDTRIP_TEST=1

# --- wandb ---
export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=02_arithmetic_coder
# RUN_ID=02_zstd_seed42  (set per-run)
# SEED=42                (set per-run)
