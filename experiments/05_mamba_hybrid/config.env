export DATA_DIR=/workspace/data/
# Experiment 05 — Mamba hybrid. Source then run:
#   source experiments/05_mamba_hybrid/config.env
#   torchrun --standalone --nproc_per_node=3 experiments/05_mamba_hybrid/tw_eval.py
#
# Requires `mamba-ssm` (added to Containerfile). If not installed inside the
# container yet:
#   podman exec pg-dev pip install mamba-ssm causal-conv1d --no-build-isolation

# --- canonical SOTA stack ---
export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

# --- Mamba toggles ---
# Single Mamba block at layer 6 (between loop and parallel-residual phases).
# Try '' for pure transformer baseline, '6' for one Mamba, '2,8' for two etc.
export MAMBA_LAYER_INDICES=6
export MAMBA_D_STATE=16
export MAMBA_D_CONV=4
export MAMBA_EXPAND=2

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=05_mamba_hybrid
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
export COMPRESSOR=brotli
