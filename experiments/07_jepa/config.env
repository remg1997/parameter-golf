export DATA_DIR=/workspace/data/
# Experiment 07 — T-JEPA (educational hybrid). Source then run:
#   source experiments/07_jepa/config.env
#   torchrun --standalone --nproc_per_node=1 experiments/07_jepa/tw_eval.py
# Note: --nproc_per_node=1 is recommended for the demo; multi-rank needs DDP code.

export VOCAB_SIZE=8192
export ITERATIONS=4500
export BATCH_SEQS=16
export SEQ_LEN=1024
export NUM_LAYERS=6
export PRED_LAYERS=2
export MODEL_DIM=384
export NUM_HEADS=6
export MLP_MULT=4
export N_MASK_SPANS=4
export SPAN_LEN_MEAN=32
export EMA_DECAY=0.996
export DECODER_LOSS_WEIGHT=1.0
export LR=3e-4
export WD=0.05
export WARMUP_STEPS=200

export LOG_EVERY=100

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=07_jepa
