# Container image for parameter-golf training on H100s.
# Matches the software stack used by bigbag's SOTA (val_bpb=1.0810):
#   PyTorch 2.9.1 + CUDA 12.8 + flash_attn_3 cu128_torch291 wheel.
#
# Build (rootless podman, from repo root):
#   podman build -t parameter-golf:dev -f experiments/_shared/Containerfile .
#
# Run (passes through GPUs 0, 1, 7):
#   podman run --rm -it \
#     --device nvidia.com/gpu=0 \
#     --device nvidia.com/gpu=1 \
#     --device nvidia.com/gpu=7 \
#     --security-opt=label=disable \
#     --ipc=host --shm-size=16g \
#     -v $HOME/parameter-golf:/workspace \
#     -v $HOME/.cache:/root/.cache \
#     -e WANDB_API_KEY=$WANDB_API_KEY \
#     -e HF_HUB_ENABLE_HF_TRANSFER=1 \
#     parameter-golf:dev bash

FROM pytorch/pytorch:2.9.1-cuda12.8-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential ninja-build tmux \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && \
    pip install \
        numpy \
        sentencepiece \
        brotli \
        wandb \
        huggingface-hub \
        hf_transfer \
        datasets \
        tqdm

# flash_attn_3 — Hopper build matched to torch 2.9.1 + CUDA 12.8.
# Using --no-deps so it doesn't try to reinstall torch.
RUN pip install flash_attn_3 --no-deps \
        --find-links https://windreamer.github.io/flash-attention3-wheels/cu128_torch291/

WORKDIR /workspace
CMD ["bash"]
