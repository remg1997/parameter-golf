export DATA_DIR=/workspace/data/
# Experiment 08 — Byte-PPM mixer at eval time. Source then run:
#   source experiments/08_ppm_mixer/config.env
#   torchrun --standalone --nproc_per_node=3 experiments/08_ppm_mixer/tw_eval.py

# --- canonical SOTA stack (bigbag, 1.0810 / our reproduction 1.07987) ---
export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

# --- PPM mixer toggles (eval-time only) ---
export PPM_MIXER_ENABLED=1
export PPM_ORDER=4
export PPM_H=0.9
export PPM_L=0.05
export PPM_T=0.9

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=08_ppm_mixer
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
export COMPRESSOR=brotli
