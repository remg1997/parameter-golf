export DATA_DIR=/workspace/data/
# 03_qat_sdclip — canonical SOTA env vars + QAT activation.
# Source with: `set -a; source config.env; set +a` then run torchrun.

# QAT (this experiment's variant)
export QAT_ENABLED=1
export QAT_START_FRAC=0.85
export QAT_RAMP_FRAC=0.05
export QAT_BITS=6
export QAT_K_SIGMAS=12.85
export QAT_APPLY_TO_EMBED=0

# Canonical SOTA settings (matches bigbag 1.0810 record)
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3

# extended wallclock for ws=3 (~2.67x of 8xH100 to hit ~5088 steps)
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
