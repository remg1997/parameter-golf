export DATA_DIR=/workspace/data/
# Experiment 03 ALT: EARLIER QAT activation (more exposure).
# Default QAT_START_FRAC=0.85 gave the model only ~674 steps of fake-quantized
# training -> exact tie. The hypothesis: model needs longer exposure to adapt
# to operate post-quantization. Activate at frac=0.6 (40% of training under
# QAT) with a slower 10% ramp.

export QAT_ENABLED=1
export QAT_START_FRAC=0.6
export QAT_RAMP_FRAC=0.1
export QAT_BITS=6
export QAT_K_SIGMAS=12.85
export QAT_APPLY_TO_EMBED=0

export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=03_qat_sdclip_early
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
export COMPRESSOR=brotli
