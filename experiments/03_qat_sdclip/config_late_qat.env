export DATA_DIR=/workspace/data/
# Experiment 03 ALT: late + gentle QAT activation.
# Default activated QAT at frac=0.85 with 5% ramp. If that hurt convergence
# (training had to adapt to fake-quantized weights), late activation gives
# the model more "clean" gradient signal first. QAT_START_FRAC=0.95 means
# QAT is on for only the last 5% of training — barely any time to adapt,
# but no risk of disrupting earlier learning.

export QAT_ENABLED=1
export QAT_START_FRAC=0.95
export QAT_RAMP_FRAC=0.02
export QAT_BITS=6
export QAT_K_SIGMAS=12.85
export QAT_APPLY_TO_EMBED=0

export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=03_qat_sdclip_late
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
export COMPRESSOR=brotli
