export DATA_DIR=/workspace/data/
# Experiment 06 — discrete (masked) text diffusion. Source then run:
#   source experiments/06_text_diffusion/config.env
#   torchrun --standalone --nproc_per_node=3 experiments/06_text_diffusion/tw_eval.py

export VOCAB_SIZE=8192
export ITERATIONS=4500
export BATCH_SEQS=16
export SEQ_LEN=1024
export NUM_LAYERS=8
export MODEL_DIM=384
export NUM_HEADS=6
export MLP_MULT=4
export LR=3e-4
export WD=0.05
export WARMUP_STEPS=200

# Diffusion-specific
export EPS_T=1e-3
export EVAL_T_SAMPLES=32
export EVAL_MC_PER_T=4
export EVAL_MAX_SEQS=256

export LOG_EVERY=100

export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=06_text_diffusion
