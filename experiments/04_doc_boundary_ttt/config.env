export DATA_DIR=/workspace/data/
# Experiment 04 — doc-boundary TTT chunking. Source then run:
#   source experiments/04_doc_boundary_ttt/config.env
#   torchrun --standalone --nproc_per_node=3 experiments/04_doc_boundary_ttt/tw_eval.py

# --- canonical SOTA stack (bigbag, 1.0810) ---
export VOCAB_SIZE=8192
export QK_GAIN_INIT=5.25
export TTT_ENABLED=1
export TTT_LR=0.005
export TTT_EPOCHS=3
export TTT_CHUNK_TOKENS=32768
export LOOP_START=3
export LOOP_END=5
export NUM_LOOPS=2
export ENABLE_LOOPING_AT=0.35
export PARALLEL_RESIDUAL_START=7
export MUON_WD=0.095
export MATRIX_LR=0.022
export EMA_DECAY=0.9965
export WARMDOWN_FRAC=0.72

# --- experiment 04 toggles ---
export TTT_DOC_BOUNDARY_ENABLED=1
# Default -1 means "resolve to sp.bos_id() at runtime" (= 1 for SP8192 here)
export TTT_DOC_SEP_TOKEN=-1
export TTT_MIN_CHUNK_TOKENS=16384

# --- wandb ---
export WANDB_PROJECT=parameter-golf
export WANDB_GROUP=04_doc_boundary_ttt
# RUN_ID=04_docttt_seed42  (set per-run)
# SEED=42                  (set per-run)

# extended wallclock for ws=3 (~2.67x of 8xH100 to hit ~5088 steps)
export MAX_WALLCLOCK_SECONDS=0
export ITERATIONS=4500
